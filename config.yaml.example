database:
  url: "postgres://finagent:secret@localhost:5432/finagent?sslmode=disable"
  # readonly_url: "postgres://finagent_ro:finagent_ro_secret@localhost:5432/finagent?sslmode=disable"
  # Run scripts/setup_readonly_role.sql as superuser first, then set this to enable SQL agent tools.
  max_connections: 10
  auto_migrate: true

llm:
  base_url: "http://localhost:11434/v1"
  api_key: ""  # FINAGENT_LLM__API_KEY
  routing:
    chat_model:      "qwen3:14b"
    analysis_model:  "qwen3:14b"
    tagging_model:   "qwen3:14b"
    embed_model:     "nomic-embed-text"
    summarize_model: "qwen3:14b"

agent:
  max_tool_rounds:  20
  history_messages: 20

channel:
  cli:
    default_user: "alice"
  # matrix:
  #   homeserver_url: "https://matrix.example.com"
  #   user_id: "@jn66bot:matrix.example.com"
  #   access_token: ""           # FINAGENT_CHANNEL__MATRIX__ACCESS_TOKEN
  #   encryption_enabled: true
  #   crypto_store_path: "/var/lib/jn66/crypto.db"  # SQLite file for E2E key store; created on first run
  #   pickle_key: ""             # random secret; encrypts the crypto store at rest
  #   # recovery_key: ""         # optional: SSSS cross-signing recovery key
  #   allowed_users:
  #     - "@alice:matrix.example.com"
  #   users:
  #     "@alice:matrix.example.com": "alice"  # Matrix ID → finagent username

api:
  listen: ":8082"

log:
  level:  "info"   # debug|info|warn|error — override with FINAGENT_LOG__LEVEL
  format: "text"   # text (dev) or json (prod) — override with FINAGENT_LOG__FORMAT

users:
  - username: "alice"
    name: "Alice"
    email: "alice@example.com"
    timezone: "Asia/Kolkata"

api_keys:
  alice: "changeme"  # FINAGENT_API_KEYS__ALICE